<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws a system-owned launch surface BEFORE Compose. -->
    <style name="Theme.Sawti" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/sawti_aurora_window</item>
        <item name="android:windowSplashScreenBackground">#153C97</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
